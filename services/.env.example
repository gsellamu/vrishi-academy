# =============================================================================
# VRishi Academy -- Environment Configuration
# =============================================================================
# Copy to .env and fill in all REQUIRED values.
# This file is safe to commit (no secrets).
#
# Generate secrets:
#   JWT:      openssl rand -base64 32
#   DB pass:  openssl rand -base64 24
#   Invite:   choose a memorable phrase
# =============================================================================

# -- REQUIRED: Secrets (no defaults -- services fail-fast if missing) ---------
ACADEMY_DB_PASSWORD=<generate-with-openssl-rand>
ACADEMY_DB_URL=postgresql://academy:${ACADEMY_DB_PASSWORD}@localhost:5432/academy
JWT_SECRET_KEY=<generate-with-openssl-rand-base64-32>
ACADEMY_INVITE_CODE=<your-private-invite-code>

# -- Environment (controls security behavior) --------------------------------
# development = insecure defaults allowed, Swagger enabled
# staging     = insecure defaults blocked, Swagger disabled
# production  = insecure defaults blocked, Swagger disabled, HSTS active
ACADEMY_ENV=development

# -- Database -----------------------------------------------------------------
DB_MIN_POOL=2
DB_MAX_POOL=10
DB_TIMEOUT=15
DB_SSL=false
# Set DB_SSL=true for AWS RDS, Azure Database, GCP Cloud SQL

# -- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/3

# -- AI / Coaching ------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b
COACH_TIMEOUT=15

# -- Kafka (optional) --------------------------------------------------------
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# -- HTTP Security ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3070
# Production: CORS_ORIGINS=https://www.vrishihypno.com,https://academy.vrishihypno.com
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type,X-Request-ID
BODY_MAX_BYTES=1048576

# -- Rate Limiting ------------------------------------------------------------
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=10

# -- Registration -------------------------------------------------------------
ACADEMY_OPEN_REGISTRATION=false
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# -- JWT Tokens ---------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
